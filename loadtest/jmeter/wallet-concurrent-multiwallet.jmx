<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
<hashTree>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="NovaWallet - Concurrent Multi-Wallet" enabled="true">
<stringProp name="TestPlan.comments">setUp group creates and funds N wallets (-Jwallets, default 10, minimum 2) and stores them as JMeter properties. Concurrent users then run a weighted mix (-Jcredit_pct/-Jstatement_pct/-Jtransfer_pct) against random wallets. Transfers may return 200, 422 (insufficient funds) or 429 (per-user rate limit); anything else, including 5xx, fails.</stringProp>
<boolProp name="TestPlan.functional_mode">false</boolProp>
<boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
<elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
<collectionProp name="Arguments.arguments">
<elementProp name="HOST" elementType="Argument"><stringProp name="Argument.name">HOST</stringProp><stringProp name="Argument.value">${__P(host,localhost)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
<elementProp name="PORT" elementType="Argument"><stringProp name="Argument.name">PORT</stringProp><stringProp name="Argument.value">${__P(port,5000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
<elementProp name="PROTOCOL" elementType="Argument"><stringProp name="Argument.name">PROTOCOL</stringProp><stringProp name="Argument.value">${__P(protocol,http)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
<elementProp name="CREDIT_KOBO" elementType="Argument"><stringProp name="Argument.name">CREDIT_KOBO</stringProp><stringProp name="Argument.value">${__P(credit_kobo,100000000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
<elementProp name="SETTLE_WAIT_MS" elementType="Argument"><stringProp name="Argument.name">SETTLE_WAIT_MS</stringProp><stringProp name="Argument.value">${__P(settle_wait_ms,10000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
<elementProp name="AMOUNT_KOBO" elementType="Argument"><stringProp name="Argument.name">AMOUNT_KOBO</stringProp><stringProp name="Argument.value">${__P(amount_kobo,1000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
<elementProp name="TRANSFER_KOBO" elementType="Argument"><stringProp name="Argument.name">TRANSFER_KOBO</stringProp><stringProp name="Argument.value">${__P(transfer_kobo,100)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
</collectionProp>
</elementProp>
<stringProp name="TestPlan.user_define_classpath"></stringProp>
</TestPlan>
<hashTree>
<SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp - create and fund wallets" enabled="true">
<stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
<elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
<boolProp name="LoopController.continue_forever">false</boolProp>
<stringProp name="LoopController.loops">1</stringProp>
</elementProp>
<stringProp name="ThreadGroup.num_threads">${__P(wallets,10)}</stringProp>
<stringProp name="ThreadGroup.ramp_time">${__P(rampup,30)}</stringProp>
<boolProp name="ThreadGroup.scheduler">false</boolProp>
<stringProp name="ThreadGroup.duration"></stringProp>
<stringProp name="ThreadGroup.delay"></stringProp>
<boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
</SetupThreadGroup>
<hashTree>
<HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Content-Type: application/json" enabled="true">
<collectionProp name="HeaderManager.headers">
<elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
<elementProp name="" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
</collectionProp>
</HeaderManager>
