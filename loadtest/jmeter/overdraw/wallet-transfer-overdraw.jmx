<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="NovaWallet - Transfer Overdraw (concurrent debits vs one balance)">
      <stringProp name="TestPlan.comments">Proves the guarded-UPDATE debit under contention. Defaults: 50 concurrent transfers of 50,000 kobo (N500) against a 1,000,000 kobo (N10,000) balance =&gt; exactly 20 succeed (200), 30 are rejected with 422 &apos;Insufficient balance&apos;, final sender balance 0, receiver balance 1,000,000. Override with -Jrequests -Jamount_kobo -Jbalance_kobo; expectations are derived (floor(balance/amount) successes), nothing is hard-coded to 50/20. setUp creates a sender and a receiver, funds the sender through /credit and polls until the deposit consumer has settled it (-Jsettle_wait_ms per attempt, -Jsetup_attempts). All requests are released together by a Synchronizing Timer. A 429 (rate limit) or any 5xx FAILS the plan: the transfer limit must be raised above -Jrequests (RATELIMIT_TRANSFER_PERMIT_LIMIT, default 1000 in docker-compose) or the test would pass for the wrong reason. tearDown counts outcomes from per-thread properties s_{n} and re-reads both balances; a wrong result shows up as the sample &apos;OVERDRAW FAILED (401 by design) ...&apos;, success as &apos;OVERDRAW OK ...&apos;. No scripting (Groovy/JSR223), so it runs on any JDK.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(host,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(port,5000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="REQUESTS" elementType="Argument">
            <stringProp name="Argument.name">REQUESTS</stringProp>
            <stringProp name="Argument.value">${__P(requests,50)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AMOUNT_KOBO" elementType="Argument">
            <stringProp name="Argument.name">AMOUNT_KOBO</stringProp>
            <stringProp name="Argument.value">${__P(amount_kobo,50000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="BALANCE_KOBO" elementType="Argument">
            <stringProp name="Argument.name">BALANCE_KOBO</stringProp>
            <stringProp name="Argument.value">${__P(balance_kobo,1000000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SETTLE_WAIT_MS" elementType="Argument">
            <stringProp name="Argument.name">SETTLE_WAIT_MS</stringProp>
            <stringProp name="Argument.value">${__P(settle_wait_ms,5000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
