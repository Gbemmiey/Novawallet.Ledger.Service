<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>99f9c618-64bb-47b6-9552-eb6d9b81184b</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

	<ItemGroup>
		<!-- OpenAPI / Scalar - used directly by Features/Transfers/TransferEndpoint.cs (.WithOpenApi) -->
		<PackageReference Include="Microsoft.AspNetCore.JsonPatch" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
		<PackageReference Include="Scalar.AspNetCore" />

		<!-- Validation - Program.cs resolves IEnumerable&lt;IValidator&gt; as a fail-fast startup check -->
		<PackageReference Include="FluentValidation" />

		<!-- Microsoft Extensions & Tooling -->
		<PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NovaWallet.Domain\NovaWallet.Domain.csproj" />
		<ProjectReference Include="..\NovaWallet.Application\NovaWallet.Application.csproj" />
		<ProjectReference Include="..\NovaWallet.Infrastructure\NovaWallet.Infrastructure.csproj" />
	</ItemGroup>

</Project>
