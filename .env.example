# -----------------------------------------------------------------------------
# NovaWallet.Ledger.Service — environment template
#
# Copy this file to `.env` (already git-ignored via the repo's `*.env` rule) and
# adjust values as needed. The committed `.env` in this repo already contains
# working dev-only placeholders so `docker compose up --build` works with zero
# setup — this file exists so the shape of required configuration is tracked
# in git even though the real `.env` is not.
#
# NONE of the values below are real secrets. Do not reuse them anywhere beyond
# local/dev evaluation of this take-home project.
# -----------------------------------------------------------------------------

# --- PostgreSQL (core stack) ---
POSTGRES_DB=novawallet
POSTGRES_USER=novawallet
POSTGRES_PASSWORD=dev-only-postgres-password-change-me
POSTGRES_PORT=5432

# Consumed directly by NovaWallet.Api.Extensions.ConnectionStringExtensions
# (Program.cs throws InvalidOperationException at startup if this is missing).
# Host must be the Compose service name ("postgres"), not localhost, since the
# API and Postgres run in separate containers on the same Compose network.
NOVAWALLET_LEDGER_CONNECTION_STRING=Host=postgres;Port=5432;Database=novawallet;Username=novawallet;Password=dev-only-postgres-password-change-me

# --- Redis 8 (core stack; optional at runtime — HybridCache degrades to
# in-memory-only idempotency if unreachable, but wired up here for the full
# documented behavior). The vanilla redis image has no REDIS_PASSWORD env
# var support, so auth is forced on via `--requirepass` in docker-compose.yml;
# REDIS_URI must carry the same password as a `password=` connection-string
# token (StackExchange.Redis's ConfigurationOptions.Parse supports this natively) ---
REDIS_PORT=6379
REDIS_PASSWORD=dev-only-redis-password-change-me
REDIS_URI=redis:6379,password=dev-only-redis-password-change-me

# --- JWT (core stack; app fails ValidateOnStart() without these) ---
Jwt__SecretKey=dev-only-jwt-signing-key-CHANGE-ME-1234567890abcdefABCDEF
Jwt__Issuer=NovaWallet.Ledger.Service
Jwt__Audience=NovaWallet.Ledger.Clients
Jwt__TokenExpirationTimeInMinutes=60

# --- API host port mapping ---
API_HTTP_PORT=5000

# --- RabbitMQ (core stack, by explicit stakeholder request — NOT consumed by
# any running code path today; see README §"Technical Stack" note and
# AI_USAGE.md's Prompt 2 addendum for how this decision evolved) ---
RABBITMQ_USER=novawallet
RABBITMQ_PASSWORD=dev-only-rabbitmq-password-change-me

# -----------------------------------------------------------------------------
# Optional: `observability` Compose profile only
# (docker compose --profile observability -f docker-compose.yml -f docker-compose.observability.yml up)
# Not required for the core deliverable — the OTel Collector is not consumed
# by any code path today (the app exports OTLP directly and no-ops if nothing
# is listening). OBSERVABILITY_EXPORTER_URI defaults to the collector's
# Compose-network hostname if left unset; override to repoint the exporter
# elsewhere (e.g. a Grafana Alloy/Agent, or a differently-named collector).
# The Collector forwards traces/metrics/logs to a real Grafana Cloud tenant, so
# GRAFANA_CLOUD_* are genuine third-party credentials you'd have to supply
# yourself — left blank intentionally, no placeholder invented.
# -----------------------------------------------------------------------------
OBSERVABILITY_EXPORTER_URI=http://otel-collector:4317
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_BASIC_AUTH_HEADER=
