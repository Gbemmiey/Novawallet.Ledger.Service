# -----------------------------------------------------------------------------
# NovaWallet.Ledger.Service — environment template
#
# Copy this file to `.env` (already git-ignored via the repo's `*.env` rule) and
# adjust values as needed. The committed `.env` in this repo already contains
# working dev-only placeholders so `docker compose up --build` works with zero
# setup — this file exists so the shape of required configuration is tracked
# in git even though the real `.env` is not.
#
# NONE of the values below are real secrets. Do not reuse them anywhere beyond
# local/dev evaluation of this take-home project.
# -----------------------------------------------------------------------------

# --- PostgreSQL (core stack) ---
POSTGRES_DB=novawallet
POSTGRES_USER=novawallet
POSTGRES_PASSWORD=dev-only-postgres-password-change-me
POSTGRES_PORT=5432

# Consumed directly by NovaWallet.Api.Extensions.ConnectionStringExtensions
# (Program.cs throws InvalidOperationException at startup if this is missing).
# Host must be the Compose service name ("postgres"), not localhost, since the
# API and Postgres run in separate containers on the same Compose network.
# Also the only variable the one-shot `migrator` Compose service needs (it
# runs `api`'s own image with `--migrate-only`, applies pending EF Core
# migrations, and exits before `api` starts — see docker-compose.yml).
NOVAWALLET_LEDGER_CONNECTION_STRING=Host=postgres;Port=5432;Database=novawallet;Username=novawallet;Password=dev-only-postgres-password-change-me

# --- Redis 8 (core stack; optional at runtime — HybridCache degrades to
# in-memory-only idempotency if unreachable, but wired up here for the full
# documented behavior). The vanilla redis image has no REDIS_PASSWORD env
# var support, so auth is forced on via `--requirepass` in docker-compose.yml;
# REDIS_URI must carry the same password as a `password=` connection-string
# token (StackExchange.Redis's ConfigurationOptions.Parse supports this natively) ---
REDIS_PORT=6379
REDIS_PASSWORD=dev-only-redis-password-change-me
REDIS_URI=redis:6379,password=dev-only-redis-password-change-me

# --- JWT (core stack; app fails ValidateOnStart() without these) ---
Jwt__SecretKey=replace-with-a-random-signing-key-of-at-least-32-characters
Jwt__Issuer=NovaWallet.Ledger.Service
Jwt__Audience=NovaWallet.Ledger.Clients
Jwt__TokenExpirationTimeInMinutes=60

# --- API host port mapping ---
API_HTTP_PORT=5000

# --- RabbitMQ (part of the default stack, by explicit stakeholder request —
# NOT consumed by any running code path today; see README §"Technical Stack"
# note and AI_USAGE.md's Prompt 2 addendum for how this decision evolved) ---
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=novawallet
RABBITMQ_PASSWORD=dev-only-rabbitmq-password-change-me

# -----------------------------------------------------------------------------
# OpenTelemetry Collector + OpenObserve (part of the default stack —
# `docker compose up` starts these unconditionally, no profile needed).
# Still not required for the core deliverable in the sense that no code path
# consumes them today (the app exports OTLP directly and no-ops if nothing is
# listening). OBSERVABILITY_EXPORTER_URI defaults to the collector's
# Compose-network hostname if left unset; override to repoint the exporter
# elsewhere (e.g. a Grafana Alloy/Agent, or a differently-named collector).
#
# The Collector forwards traces/metrics/logs to a local OpenObserve instance
# (also always started) — no third-party account or credentials required.
# OpenObserve's web UI/API listens on OPENOBSERVE_HTTP_PORT; log in with
# ZO_ROOT_USER_EMAIL/ZO_ROOT_USER_PASSWORD. OpenObserve refuses to boot
# (panics the container) if the password doesn't meet its own complexity
# rule: 8-128 chars, at least one lowercase, one uppercase, one digit, and
# one special character. OPENOBSERVE_AUTH_HEADER is the HTTP Basic header
# the Collector's exporter authenticates with — it must be
# base64(ZO_ROOT_USER_EMAIL:ZO_ROOT_USER_PASSWORD); regenerate it with
# `printf '%s' "$ZO_ROOT_USER_EMAIL:$ZO_ROOT_USER_PASSWORD" | base64` if you
# change either of those two values.
# -----------------------------------------------------------------------------
OBSERVABILITY_EXPORTER_URI=http://otel-collector:4317
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
OPENOBSERVE_HTTP_PORT=5080
OPENOBSERVE_ORG=default
ZO_ROOT_USER_EMAIL=admin@novawallet.local
ZO_ROOT_USER_PASSWORD=Change-Me-Example-1!
# Placeholder only: replace with the output of the base64 command described
# above, using the email and password you set in this file, before running
# `docker compose up`. Example:
#   printf '%s' "admin@novawallet.local:<your password>" | base64
# then set this to `Basic <that output>`.
OPENOBSERVE_AUTH_HEADER=Basic <base64-of-email:password>
